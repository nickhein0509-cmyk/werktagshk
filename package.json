{
  "name": "werktag-shk-lernbuddy",
  "private": true,
  "version": "0.15.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run build && npm run test && npm run test:assistenz && npm run test:cloud-assistance && npm run test:workflow && npm run test:e2e",
    "format": "prettier --write src tests *.ts",
    "test:assistenz": "node --test scripts/test-assistenz-gateway.mjs scripts/test-assistance-cloud.mjs scripts/test-assistant-map.mjs",
    "test:cloud-assistance": "node --test supabase/functions/*/*.test.mjs",
    "test:workflow": "node --test scripts/test-start-work.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "lucide-react": "1.61.0",
    "maplibre-gl": "6.16.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@electric-sql/pglite": "0.5.13",
    "@playwright/test": "1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
